# ==============================================================================
# klpod221 Kontrol Panel (KCP) — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your production .env file to version control.
# ==============================================================================

# Cloudflare Tunnel Token & OAuth
TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Application Configuration
APP_NAME="klpod221 Kontrol Panel"
APP_VERSION="2.0.0"
DEBUG=False

# MCP Server Sub-module Configurations
MCP_SERVER_NAME="klpod221-mcp"
MCP_SERVER_DESCRIPTION="Private MCP server for klpod221 homelab infrastructure"
MCP_SERVER_INSTRUCTIONS="Unified connector for server telemetry, media stack, torrents, and notes."

# Host & Port Binding
HOST="0.0.0.0"
PORT=8000

# Public Domain (Behind Reverse Proxy / Cloudflare Tunnel)
BASE_URL="https://kcp.example.com"

# PostgreSQL Credentials & Connection URL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="generate_a_strong_postgres_password"
POSTGRES_DB="postgres"
DATABASE_URL="postgresql+asyncpg://postgres:generate_a_strong_postgres_password@postgres:5432/mcp_db"

# Security & Secrets (Cryptographically Secure Random Strings)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="generate_a_random_jwt_secret_with_openssl_rand_hex_32"
SESSION_SECRET_KEY="generate_a_random_session_secret_with_openssl_rand_hex_32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=True

# Default Admin Credentials (Seeded on First Startup)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"
DEFAULT_ADMIN_EMAIL="admin@example.com"

# Default OAuth Client (e.g. for Google Gemini Connected App)
DEFAULT_CLIENT_ID="gemini_client"
DEFAULT_CLIENT_SECRET="generate_a_random_client_secret_with_openssl_rand_hex_24"
DEFAULT_CLIENT_NAME="Google Gemini"

# Homelab & Media Stack Internal Endpoints (Container-to-Container)
HOMEPAGE_URL="http://homepage:3000"

RADARR_URL="http://radarr:7878"
RADARR_API_KEY="your_radarr_api_key_here"
RADARR_DEFAULT_ROOT_FOLDER="/data/media/Movies"
RADARR_DEFAULT_QUALITY_PROFILE_ID=7

SONARR_URL="http://sonarr:8989"
SONARR_API_KEY="your_sonarr_api_key_here"
SONARR_DEFAULT_ROOT_FOLDER="/data/media/TV_Shows"
SONARR_DEFAULT_QUALITY_PROFILE_ID=7

LIDARR_URL="http://lidarr:8686"
LIDARR_API_KEY="your_lidarr_api_key_here"
LIDARR_DEFAULT_ROOT_FOLDER="/data/media/Music"
LIDARR_DEFAULT_QUALITY_PROFILE_ID=1
LIDARR_DEFAULT_METADATA_PROFILE_ID=1

PROWLARR_URL="http://prowlarr:9696"
PROWLARR_API_KEY="your_prowlarr_api_key_here"

BAZARR_URL="http://bazarr:6767"
BAZARR_API_KEY="your_bazarr_api_key_here"

JELLYFIN_URL="http://jellyfin:8096"
JELLYFIN_EXTERNAL_URL="https://media.example.com"
JELLYFIN_API_KEY="your_jellyfin_api_key_here"

JELLYSEERR_URL="http://jellyseerr:5055"
JELLYSEERR_EXTERNAL_URL="https://request.example.com"
JELLYSEERR_API_KEY="your_jellyseerr_api_key_here"

QBITTORRENT_URL="http://qbittorrent:8080"
QBITTORRENT_USERNAME="admin"
QBITTORRENT_PASSWORD="your_qbittorrent_password"

TRILIUM_URL="http://triliumnext:8080"
TRILIUM_ETAPI_TOKEN=""
TRILIUM_PASSWORD=""

